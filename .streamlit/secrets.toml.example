# Copy to .streamlit/secrets.toml locally; never commit real credentials.
DATABASE_PATH = "council.db"
DAILY_REQUEST_LIMIT = 20
GEMINI_API_KEY = "replace-me"
GEMINI_MODEL = "gemini-2.0-flash"
GEMINI_FALLBACK_MODEL = "gemini-2.0-flash-lite"

# Optional Google OIDC. See Streamlit's authentication documentation.
OAUTH_CLIENT_ID = "replace-me"

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-me-with-a-long-random-value"

[auth.google]
client_id = "replace-me"
client_secret = "replace-me"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
